{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "dagster-authkit Helm chart values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "strategy": {
      "type": "object"
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array"
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "initContainers": {
      "type": "array"
    },
    "authkit": {
      "type": "object",
      "properties": {
        "backend": {
          "enum": [
            "sql",
            "sqlite",
            "ldap",
            "proxy",
            "oauth",
            "dummy"
          ]
        },
        "existingSecret": {
          "type": "string"
        },
        "sessionMaxAge": {
          "type": "integer",
          "minimum": 60
        },
        "cookieSecure": {
          "type": "boolean"
        },
        "cookieSameSite": {
          "type": "string",
          "pattern": "^(?i:lax|strict|none)$"
        },
        "rateLimit": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxAttempts": {
              "type": "integer",
              "minimum": 1
            },
            "windowSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "logLevel": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "auditLog": {
          "type": "boolean"
        },
        "serviceToken": {
          "type": "object",
          "properties": {
            "role": {
              "enum": [
                "VIEWER",
                "LAUNCHER",
                "EDITOR",
                "ADMIN"
              ]
            }
          }
        },
        "proxy": {
          "type": "object",
          "properties": {
            "trustAll": {
              "type": "boolean"
            }
          }
        },
        "rbac": {
          "type": "object",
          "properties": {
            "unknownMutationRole": {
              "enum": [
                "VIEWER",
                "LAUNCHER",
                "EDITOR",
                "ADMIN"
              ]
            },
            "restWriteRole": {
              "enum": [
                "VIEWER",
                "LAUNCHER",
                "EDITOR",
                "ADMIN"
              ]
            }
          }
        },
        "ldap": {
          "type": "object",
          "properties": {
            "useTLS": {
              "type": "boolean"
            },
            "timeout": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "dagster": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "object",
          "properties": {
            "module": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "existingConfigMap": {
              "type": "string"
            }
          }
        },
        "instance": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "existingConfigMap": {
              "type": "string"
            }
          }
        },
        "extraArgs": {
          "type": "array"
        },
        "home": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteOncePod",
            "ReadWriteMany"
          ]
        }
      }
    }
  }
}
